<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>金權筆記 | 政治獻金透明化與選戰資本趨勢終端</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700;900&family=JetBrains+Mono:wght@400;700;800&family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', 'Noto Sans TC', sans-serif;
            background-color: #040815;
            color: #f1f5f9;
            scroll-behavior: smooth;
        }
        .font-mono {
            font-family: 'JetBrains Mono', monospace;
        }
        /* Glassmorphism panel styling inspired by 2199142188798737768.jpeg */
        .cyber-panel {
            background: rgba(13, 22, 43, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(6, 182, 212, 0.12);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        }
        .cyber-panel:hover {
            border-color: rgba(6, 182, 212, 0.35);
            box-shadow: 0 16px 45px rgba(6, 182, 212, 0.15);
        }
        .text-glow-cyan {
            text-shadow: 0 0 15px rgba(6, 182, 212, 0.5);
        }
        .text-glow-gold {
            text-shadow: 0 0 15px rgba(245, 158, 11, 0.5);
        }
        /* Custom range slider styling matching buy vs rent simulation */
        .slider {
            -webkit-appearance: none;
            width: 100%;
            height: 6px;
            border-radius: 999px;
            background: #111e36;
            outline: none;
        }
        .slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #06b6d4;
            cursor: pointer;
            box-shadow: 0 0 12px rgba(6, 182, 212, 0.6);
            transition: transform 0.1s ease;
        }
        .slider::-webkit-slider-thumb:hover {
            transform: scale(1.2);
        }
        /* Active Tab indicator style */
        .active-tab {
            border-bottom: 2px solid #06b6d4;
            color: #06b6d4;
            text-shadow: 0 0 10px rgba(6, 182, 212, 0.3);
        }
    </style>
</head>
<body class="antialiased selection:bg-cyan-500 selection:text-slate-900">

    <!-- Navigation Bar -->
    <nav class="sticky top-0 z-50 bg-[#040815]/90 backdrop-blur-md border-b border-slate-900 px-6 py-4 flex justify-between items-center">
        <div class="flex flex-col">
            <strong class="text-lg md:text-xl font-black text-white tracking-widest flex items-center gap-2">
                金權筆記 <span class="text-[10px] px-2 py-0.5 bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 rounded font-normal font-mono">A05 PRO</span>
            </strong>
            <span class="text-[9px] text-slate-500 tracking-wider uppercase font-mono">Transparency.tw / Wealth & Power Intelligence</span>
        </div>
        <!-- Tab Selectors for seamless SPA navigation -->
        <div class="flex gap-4 md:gap-8 text-xs md:text-sm font-bold text-slate-400">
            <button onclick="navigate('landing')" id="tab-landing" class="active-tab py-2 transition">專題首頁</button>
            <button onclick="navigate('directory')" id="tab-directory" class="py-2 transition">資料探索</button>
            <button onclick="navigate('trends')" id="tab-trends" class="py-2 transition">資本模擬器</button>
        </div>
    </nav>

    <!-- [SECTION 1] LANDING PAGE VIEW -->
    <div id="view-landing" class="view-panel block">
        <!-- Hero section with glowing narrative -->
        <header class="min-h-[85vh] flex flex-col justify-center items-center px-6 relative overflow-hidden">
            <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[500px] h-[300px] bg-cyan-500/10 rounded-full blur-[140px] pointer-events-none"></div>
            <div class="absolute bottom-1/4 right-10 w-[350px] h-[200px] bg-amber-500/5 rounded-full blur-[110px] pointer-events-none"></div>

            <div class="max-w-4xl mx-auto text-center z-10 space-y-8 mt-12">
                <span class="inline-flex items-center gap-2 px-3 py-1 bg-cyan-500/10 text-cyan-400 border border-cyan-500/25 text-xs font-bold rounded-full uppercase tracking-widest">
                    <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                    數據驅動 民主透明 | TRANSPARENCY.TW
                </span>
                
                <h1 class="text-4xl md:text-7xl font-black text-white leading-tight tracking-tight">
                    揭開政治帳本：<br>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-400 to-amber-400">誰在買單你的代議士？</span>
                </h1>
                
                <p class="text-slate-400 text-base md:text-lg max-w-3xl mx-auto font-light leading-relaxed">
                    為什麼這件事無比重要？透明的政治資金是民主的防腐劑。我們深度解構立委完整獻金紀錄，透過動態數據，揭露建商、金控與地方勢力如何布局政治資本。
                </p>

                <!-- Search Input Main CTA -->
                <div class="relative max-w-2xl mx-auto group">
                    <div class="absolute -inset-1 bg-gradient-to-r from-cyan-500 to-amber-500 rounded-2xl blur opacity-25 group-hover:opacity-40 transition duration-1000"></div>
                    <div class="relative flex bg-[#0d162b] border border-slate-800 rounded-xl p-2 shadow-2xl">
                        <input type="text" id="searchInputLanding" placeholder="輸入候選人姓名、政黨、特定選區..." class="w-full bg-transparent py-3 px-4 text-white text-base focus:outline-none placeholder-slate-500 font-medium">
                        <button onclick="handleSearchFromLanding()" class="bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black px-8 py-3 rounded-lg transition duration-300 shadow-lg shadow-cyan-500/20 text-xs tracking-widest flex items-center gap-2">
                            開始檢索
                        </button>
                    </div>
                </div>

                <!-- Quick tags to lower entry barrier -->
                <div class="text-xs text-slate-500 font-semibold uppercase tracking-wider">
                    熱門快速查詢：
                    <span onclick="triggerQuickTag('營造')" class="text-cyan-400 hover:text-cyan-300 underline cursor-pointer mx-1.5">#營造業捐贈</span>
                    <span onclick="triggerQuickTag('花蓮')" class="text-cyan-400 hover:text-cyan-300 underline cursor-pointer mx-1.5">#花蓮縣</span>
                    <span onclick="triggerQuickTag('王金平')" class="text-cyan-400 hover:text-cyan-300 underline cursor-pointer mx-1.5">#王金平</span>
                </div>
            </div>

            <!-- Scroll indicator -->
            <div class="absolute bottom-6 left-1/2 -translate-x-1/2 text-center z-10 pointer-events-none">
                <span class="text-[9px] text-slate-600 uppercase tracking-[0.4em] block mb-2 font-mono">Explore Below</span>
                <div class="w-5 h-8 border-2 border-slate-800 rounded-full mx-auto flex justify-center p-1">
                    <div class="w-1 h-1 bg-cyan-400 rounded-full animate-bounce"></div>
                </div>
            </div>
        </header>

        <!-- Editor's Picks (精選專題) -->
        <section class="max-w-7xl mx-auto px-6 py-24 border-t border-slate-900">
            <div class="mb-16">
                <span class="text-xs font-mono text-cyan-400 tracking-widest uppercase">Special Report</span>
                <h2 class="text-3xl font-black text-white mt-1">編輯精選：政商關係調查案例</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Case 1: Fu Kun-chi -->
                <div onclick="selectAndViewCandidate('傅崐萁')" class="cyber-panel p-8 rounded-2xl cursor-pointer flex flex-col justify-between min-h-[300px]">
                    <div>
                        <span class="text-[9px] font-mono text-amber-500 border border-amber-500/30 px-2 py-0.5 rounded">CASE 01</span>
                        <h3 class="text-2xl font-bold text-white mt-6 mb-3">東部地產開發與採礦利益</h3>
                        <p class="text-slate-400 text-sm leading-relaxed">
                            追蹤東部重量級立委的申報，發現高比例金流集中於地方營建及水泥採礦巨頭，揭開獨特的在地資本依賴。
                        </p>
                    </div>
                    <div class="flex items-center text-cyan-400 text-xs font-bold gap-1 mt-6">
                        解構傅崐萁深度金流 <span class="font-mono">→</span>
                    </div>
                </div>

                <!-- Case 2: Ker Chien-ming -->
                <div onclick="selectAndViewCandidate('柯建銘')" class="cyber-panel p-8 rounded-2xl cursor-pointer flex flex-col justify-between min-h-[300px]">
                    <div>
                        <span class="text-[9px] font-mono text-cyan-400 border border-cyan-400/30 px-2 py-0.5 rounded">CASE 02</span>
                        <h3 class="text-2xl font-bold text-white mt-6 mb-3">都市重劃與跨黨派建商布陣</h3>
                        <p class="text-slate-400 text-sm leading-relaxed">
                            分析北部資深候選人的政治獻金來源，揭露大型建商集團如何透過多重子公司在不同陣營中進行均勻布局。
                        </p>
                    </div>
                    <div class="flex items-center text-cyan-400 text-xs font-bold gap-1 mt-6">
                        解構柯建銘深度金流 <span class="font-mono">→</span>
                    </div>
                </div>

                <!-- Case 3: Simulation Shortcut -->
                <div onclick="navigate('trends')" class="cyber-panel p-8 rounded-2xl cursor-pointer flex flex-col justify-between min-h-[300px] border-l-4 border-l-amber-500">
                    <div>
                        <span class="text-[9px] font-mono text-emerald-400 border border-emerald-400/30 px-2 py-0.5 rounded">SIMULATION TOOL</span>
                        <h3 class="text-2xl font-bold text-white mt-6 mb-3">長期選戰資本增值趨勢</h3>
                        <p class="text-slate-400 text-sm leading-relaxed">
                            模擬在複利滾存模型下，不同比例的企業資金主導 vs. 群眾募資路線，在未來 5 屆選戰中累積的資本上漲趨勢。
                        </p>
                    </div>
                    <div class="flex items-center text-amber-500 text-xs font-bold gap-1 mt-6">
                        開啟上漲趨勢模擬器 <span class="font-mono">→</span>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- [SECTION 2] DATA DIRECTORY VIEW -->
    <div id="view-directory" class="view-panel hidden max-w-7xl mx-auto px-6 py-12">
        <!-- Quick Summary Metrics (關鍵數據總覽) -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-16">
            <div class="cyber-panel p-6 rounded-2xl">
                <span class="text-slate-500 text-[10px] font-bold uppercase tracking-wider block">資料庫總分析筆數</span>
                <h4 class="text-3xl font-mono font-black text-white mt-2">1,284 <span class="text-xs text-slate-500 font-normal">位</span></h4>
            </div>
            <div class="cyber-panel p-6 rounded-2xl border-l-2 border-l-cyan-500">
                <span class="text-slate-500 text-[10px] font-bold uppercase tracking-wider block">本屆申報獻金總額</span>
                <h4 class="text-3xl font-mono font-black text-cyan-400 text-glow-cyan mt-2">8.62 <span class="text-xs font-normal text-slate-500">億 NTD</span></h4>
            </div>
            <div class="cyber-panel p-6 rounded-2xl border-l-2 border-l-amber-500">
                <span class="text-slate-500 text-[10px] font-bold uppercase tracking-wider block">營利事業平均捐贈比</span>
                <h4 class="text-3xl font-mono font-black text-amber-500 text-glow-gold mt-2">55.03%</h4>
            </div>
            <div class="cyber-panel p-6 rounded-2xl">
                <span class="text-slate-500 text-[10px] font-bold uppercase tracking-wider block">平均匿名小額捐贈比</span>
                <h4 class="text-3xl font-mono font-black text-emerald-400 mt-2">14.2%</h4>
            </div>
        </div>

        <!-- Toolbar for filtering and sorting -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-8 border-b border-slate-900 pb-8">
            <div>
                <h2 class="text-3xl font-black text-white tracking-tight">政治獻金數據探勘</h2>
                <p class="text-slate-500 text-sm mt-1">輸入關鍵字過濾或依金流規模排序，點擊進入深度分析個人頁。</p>
            </div>
            <div class="flex flex-wrap gap-4 w-full md:w-auto">
                <div class="flex flex-col gap-1.5">
                    <label class="text-[10px] text-slate-500 uppercase font-bold tracking-wider">政黨過濾</label>
                    <select id="partyFilter" onchange="applyFilters()" class="bg-[#0b1224] border border-slate-800 text-slate-300 px-4 py-2.5 rounded-xl text-xs focus:outline-none focus:border-cyan-500">
                        <option value="all">全部政黨</option>
                        <option value="民主進步黨">民主進步黨</option>
                        <option value="中國國民黨">中國國民黨</option>
                        <option value="無黨籍">無黨籍</option>
                    </select>
                </div>
                <div class="flex flex-col gap-1.5">
                    <label class="text-[10px] text-slate-500 uppercase font-bold tracking-wider">依總金額排序</label>
                    <select id="sortOrder" onchange="applyFilters()" class="bg-[#0b1224] border border-slate-800 text-slate-300 px-4 py-2.5 rounded-xl text-xs focus:outline-none focus:border-cyan-500">
                        <option value="desc">申報總額：高到低 ↓</option>
                        <option value="asc">申報總額：低到高 ↑</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Search Bar specifically on Directory view -->
        <div class="mb-8">
            <input type="text" id="directorySearchInput" oninput="applyFilters()" placeholder="在此快速過濾：例如新竹、高雄、營造..." class="w-full bg-[#070d1a] border border-slate-800/80 py-4 px-6 rounded-xl text-white text-sm focus:outline-none focus:border-cyan-500 transition-all placeholder-slate-600">
        </div>

        <!-- Directory Cards Container -->
        <div id="candidatesList" class="space-y-4">
            <!-- Dynamic Injection -->
        </div>

        <!-- Loading / Pagination Indicator -->
        <div class="text-center mt-12 py-6 border-t border-slate-900">
            <span class="text-xs text-slate-500 uppercase tracking-[0.4em]">無感資料庫動態載入中 (Infinite Scroll ready)</span>
        </div>
    </div>

    <!-- [SECTION 3] SIMULATOR & TREND VIEW -->
    <div id="view-trends" class="view-panel hidden max-w-7xl mx-auto px-6 py-12">
        <div class="mb-12">
            <span class="text-xs font-mono text-amber-500 tracking-widest uppercase">Capital Multiplier Simulation</span>
            <h2 class="text-4xl font-black text-white mt-1">選戰資本累積與上漲趨勢模擬</h2>
            <p class="text-slate-500 text-sm mt-2 max-w-3xl">
                參考理財精算模型，我們將選戰經費視為一種資本累積。本模擬器計算自備選戰金，在未來數屆選戰（每屆間隔 4 年）的複利滾存模型下，比較「企業巨額主導」與「群眾募資小額」兩種路線的長期資產增值趨勢。
            </p>
        </div>

        <!-- Interactive Playground -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <!-- Left Controls (4/12) -->
            <div class="lg:col-span-4 space-y-6">
                <div class="cyber-panel p-6 rounded-2xl space-y-6">
                    <h3 class="text-sm font-bold text-cyan-400 flex items-center gap-2 tracking-wider uppercase">
                        <i class="fa-solid fa-sliders"></i> 選戰起步參數
                    </h3>
                    
                    <div>
                        <div class="flex justify-between text-xs mb-2">
                            <span class="text-slate-300">初始選戰基金 (自備款)</span>
                            <span id="initialCapitalLabel" class="font-mono font-bold text-cyan-400">NT$ 1,500 萬</span>
                        </div>
                        <input type="range" id="initialCapital" min="2000000" max="50000000" step="500000" value="15000000" class="slider" oninput="calculateSimulatorTrend()">
                    </div>

                    <div>
                        <div class="flex justify-between text-xs mb-2">
                            <span class="text-slate-300">第一屆基本開銷 (每屆支出)</span>
                            <span id="termExpensesLabel" class="font-mono font-bold text-amber-500">NT$ 2,000 萬</span>
                        </div>
                        <input type="range" id="termExpenses" min="1000000" max="40000000" step="500000" value="20000000" class="slider slider-gold" oninput="calculateSimulatorTrend()">
                    </div>

                    <div class="grid grid-cols-2 gap-4 pt-2">
                        <div>
                            <label class="block text-[10px] text-slate-500 font-bold uppercase tracking-wider mb-2">選戰物價漲幅/年 (%)</label>
                            <input type="number" id="inflationRate" step="0.1" value="2.5" class="w-full p-3 bg-slate-900/80 border border-slate-800 rounded-xl text-xs focus:outline-none focus:border-cyan-500 font-mono text-white" oninput="calculateSimulatorTrend()">
                        </div>
                        <div>
                            <label class="block text-[10px] text-slate-500 font-bold uppercase tracking-wider mb-2">預測模擬屆次 (屆)</label>
                            <select id="simulateTerms" class="w-full p-3 bg-slate-900/80 border border-slate-800 rounded-xl text-xs focus:outline-none focus:border-cyan-500 text-white" onchange="calculateSimulatorTrend()">
                                <option value="3">3 屆 (12年)</option>
                                <option value="5" selected>5 屆 (20年)</option>
                                <option value="8">8 屆 (32年)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="cyber-panel p-6 rounded-2xl space-y-6">
                    <h3 class="text-sm font-bold text-amber-400 flex items-center gap-2 tracking-wider uppercase">
                        <i class="fa-solid fa-chart-line"></i> 路線收益預期
                    </h3>

                    <div>
                        <div class="flex justify-between text-xs mb-2">
                            <span class="text-slate-300">路線 A: 企業捐贈年增率</span>
                            <span id="corporateGrowthLabel" class="font-mono font-bold text-amber-500">8.0%</span>
                        </div>
                        <input type="range" id="corporateGrowth" min="0" max="25" step="0.5" value="8.0" class="slider slider-gold" oninput="calculateSimulatorTrend()">
                        <span class="text-[9px] text-slate-500 mt-1 block">代表建商重劃與地方營建融資之年複合增值。</span>
                    </div>

                    <div>
                        <div class="flex justify-between text-xs mb-2">
                            <span class="text-slate-300">路線 B: 小額募資年增率</span>
                            <span id="crowdfundingGrowthLabel" class="font-mono font-bold text-cyan-400">4.5%</span>
                        </div>
                        <input type="range" id="crowdfundingGrowth" min="0" max="20" step="0.5" value="4.5" class="slider" oninput="calculateSimulatorTrend()">
                        <span class="text-[9px] text-slate-500 mt-1 block">代表獨立候選人藉由民意支持度增長小額募款之潛能。</span>
                    </div>
                </div>
            </div>

            <!-- Right Output & Trends Visualization Chart (8/12) -->
            <div class="lg:col-span-8 space-y-6">
                <!-- Trend Chart panel -->
                <div class="cyber-panel p-6 rounded-2xl">
                    <h3 class="text-sm font-bold text-slate-300 uppercase tracking-wider mb-6">長期選戰累積資本增值趨勢</h3>
                    <div class="h-[400px]">
                        <canvas id="trendChart"></canvas>
                    </div>
                </div>

                <!-- Simulation End Results Summary -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Route A Results -->
                    <div class="cyber-panel p-6 rounded-2xl border-t-4 border-t-amber-500">
                        <span class="text-amber-500 text-[10px] font-mono tracking-widest uppercase block mb-1">ROUTE A STATUS</span>
                        <h4 class="text-xl font-bold text-white mb-4">企業主導型終點資產</h4>
                        <div class="space-y-3 text-sm">
                            <div class="flex justify-between text-slate-400">期末企業累計資金: <span id="finalCorpFund" class="font-mono text-white font-bold">-</span></div>
                            <div class="flex justify-between text-slate-400">期末選戰累計支出: <span id="finalCorpExpense" class="font-mono text-slate-500">-</span></div>
                            <div class="border-t border-slate-800 pt-3 mt-3 flex justify-between text-base font-bold text-white">
                                累計淨政商籌碼: <span id="corpFinalNet" class="font-mono text-amber-400 text-glow-gold">-</span>
                            </div>
                        </div>
                    </div>

                    <!-- Route B Results -->
                    <div class="cyber-panel p-6 rounded-2xl border-t-4 border-t-cyan-500">
                        <span class="text-cyan-400 text-[10px] font-mono tracking-widest uppercase block mb-1">ROUTE B STATUS</span>
                        <h4 class="text-xl font-bold text-white mb-4">群眾募資型終點資產</h4>
                        <div class="space-y-3 text-sm">
                            <div class="flex justify-between text-slate-400">期末群眾累計資金: <span id="finalCrowdFund" class="font-mono text-white font-bold">-</span></div>
                            <div class="flex justify-between text-slate-400">期末選戰累計支出: <span id="finalCrowdExpense" class="font-mono text-slate-500">-</span></div>
