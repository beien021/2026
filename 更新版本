            // Create custom gradients for aesthetic transparency glow
            const gradientCorp = ctx.createLinearGradient(0, 0, 0, 400);
            gradientCorp.addColorStop(0, 'rgba(245, 158, 11, 0.25)');
            gradientCorp.addColorStop(1, 'rgba(245, 158, 11, 0.0)');

            const gradientCrowd = ctx.createLinearGradient(0, 0, 0, 400);
            gradientCrowd.addColorStop(0, 'rgba(6, 182, 212, 0.25)');
            gradientCrowd.addColorStop(1, 'rgba(6, 182, 212, 0.0)');

            trendChartObj = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: '路線 A：企業主導型累積政治資本 (NTD)',
                            data: corpData,
                            borderColor: '#fbbf24',
                            borderWidth: 3,
                            backgroundColor: gradientCorp,
                            fill: true,
                            tension: 0.35,
                            pointBackgroundColor: '#fbbf24',
                            pointHoverRadius: 7
                        },
                        {
                            label: '路線 B：群眾募資型累積政治資本 (NTD)',
                            data: crowdData,
                            borderColor: '#06b6d4',
                            borderWidth: 3,
                            backgroundColor: gradientCrowd,
                            fill: true,
                            tension: 0.35,
                            pointBackgroundColor: '#06b6d4',
                            pointHoverRadius: 7
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    scales: {
                        y: {
                            ticks: {
                                color: '#64748b',
                                callback: (val) => val / 10000 + ' 萬'
                            },
                            grid: {
                                color: 'rgba(255, 255, 255, 0.03)'
                            }
                        },
                        x: {
                            ticks: {
                                color: '#64748b'
                            },
                            grid: {
                                display: false
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                color: '#f1f5f9',
                                font: {
                                    size: 11,
                                    weight: 'bold'
                                }
                            }
                        },
                        tooltip: {
                            padding: 12,
                            backgroundColor: 'rgba(11, 22, 44, 0.95)',
                            titleColor: '#fff',
                            titleFont: { size: 13, weight: 'bold' },
                            bodyColor: '#e2e8f0',
                            borderColor: 'rgba(255, 255, 255, 0.08)',
                            borderWidth: 1,
                            callbacks: {
                                label: (context) => {
                                    return ` ${context.dataset.label.split('：')[0]}淨值: NT$ ${context.raw.toLocaleString()}`;
                                }
                            }
                        }
                    }
                }
            });
        }

        // On document load initialization sequence
        window.onload = function () {
            // Apply initial filters to render directory view
            applyFilters();
            // Default load Fu Kun-chi as pre-loaded dataset on Candidate detailed view
            selectAndViewCandidate("傅崐萁");
            // Direct user back to main landing view
            navigate('landing');
        };
    </script>
</body>
