        // Simulator calculation engine (corresponds to buy-vs-rent asset accumulation)
        function calculateSimulatorTrend() {
            // Read UI Sliders inputs
            const initialCapital = Number(document.getElementById('initialCapital').value);
            const termExpenses = Number(document.getElementById('termExpenses').value);
            const inflationRate = Number(document.getElementById('inflationRate').value) / 100;
            const simulateTerms = Number(document.getElementById('simulateTerms').value);

            const corporateGrowth = Number(document.getElementById('corporateGrowth').value) / 100;
            const crowdfundingGrowth = Number(document.getElementById('crowdfundingGrowth').value) / 100;

            // Render slider labels
            document.getElementById('initialCapitalLabel').innerText = "NT$ " + formatMoney(initialCapital);
            document.getElementById('termExpensesLabel').innerText = "NT$ " + formatMoney(termExpenses);
            document.getElementById('corporateGrowthLabel').innerText = (corporateGrowth * 100).toFixed(1) + "%";
            document.getElementById('crowdfundingGrowthLabel').innerText = (crowdfundingGrowth * 100).toFixed(1) + "%";

            // Compile chronological cycle metrics
            let labels = [];
            let corporateRouteData = [];
            let crowdfundingRouteData = [];

            // Let's model a 4-year election cycle sequence
            // Initial state (Year 0)
            labels.push("第 0 屆 (起步期)");
            corporateRouteData.push(Math.round(initialCapital));
            crowdfundingRouteData.push(Math.round(initialCapital));

            let currentCorpWarchest = initialCapital;
            let currentCrowdWarchest = initialCapital;
            let currentTermExpense = termExpenses;
            let cumulativeCorpExpense = 0;
            let cumulativeCrowdExpense = 0;

            for (let term = 1; term <= simulateTerms; term++) {
                labels.push(`第 ${term} 屆 (${term * 4}年)`);

                // Election cycle expense inflated annually over 4 years
                currentTermExpense *= Math.pow(1 + inflationRate, 4);

                // Cumulative expenditures tally
                cumulativeCorpExpense += currentTermExpense;
                cumulativeCrowdExpense += currentTermExpense;

                // Route A: Corporate sponsorship model (High growth return Stack)
                // New corporate funding injected per term modeled as growth multiplier
                currentCorpWarchest = (currentCorpWarchest * Math.pow(1 + corporateGrowth, 4)) - currentTermExpense;
                
                // Route B: Crowdfunding model (Sustained community stack)
                currentCrowdWarchest = (currentCrowdWarchest * Math.pow(1 + crowdfundingGrowth, 4)) - currentTermExpense;

                corporateRouteData.push(Math.round(currentCorpWarchest));
                crowdfundingRouteData.push(Math.round(currentCrowdWarchest));
            }

            // Update UI details elements
            document.getElementById('finalCorpFund').innerText = "NT$ " + formatMoney(currentCorpWarchest + cumulativeCorpExpense);
            document.getElementById('finalCorpExpense').innerText = "NT$ " + formatMoney(cumulativeCorpExpense);
            document.getElementById('corpFinalNet').innerText = "NT$ " + formatMoney(currentCorpWarchest);

            document.getElementById('finalCrowdFund').innerText = "NT$ " + formatMoney(currentCrowdWarchest + cumulativeCrowdExpense);
            document.getElementById('finalCrowdExpense').innerText = "NT$ " + formatMoney(cumulativeCrowdExpense);
            document.getElementById('crowdFinalNet').innerText = "NT$ " + formatMoney(currentCrowdWarchest);

            // Re-render chart trends
            drawTrendsChart(labels, corporateRouteData, crowdfundingRouteData);
        }

        // Draw the simulation chart canvas beautifully
        function drawTrendsChart(labels, corpData, crowdData) {
            const ctx = document.getElementById('trendChart').getContext('2d');
            
            if (trendChartObj) {
